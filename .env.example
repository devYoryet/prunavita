# Copia este archivo como .env y completa las claves.
# .env esta en .gitignore — nunca se sube al repositorio.

# Busqueda de fotos de stock reales (gratis: https://www.pexels.com/api/)
PEXELS_API_KEY=

# Generacion de imagenes cuando no hay stock adecuado (mapas, esquemas, graficos)
OPENAI_API_KEY=
