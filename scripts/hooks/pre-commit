#!/bin/sh
# Hook pre-commit — Prunavita.cl
#
# Dos verificaciones automaticas antes de cada commit:
#   1. Que ninguna noticia repita foto de portada.
#   2. Que el sitemap declare la fecha real de cambio de cada pagina.
#
# Instalar una vez por maquina (desde la raiz del repo):
#     git config core.hooksPath scripts/hooks
#
# Saltarlo en un caso puntual:
#     git commit --no-verify

if ! command -v python >/dev/null 2>&1; then
    echo "[pre-commit] Aviso: python no disponible, se omiten las verificaciones."
    exit 0
fi

# ---------- 1. Portadas unicas (solo si cambian noticias) ----------
if git diff --cached --name-only | grep -q '^noticias/'; then
    echo "[pre-commit] Verificando que ninguna noticia repita portada..."
    if ! python scripts/portada_noticia.py auditar; then
        echo ""
        echo "[pre-commit] COMMIT BLOQUEADO: hay imagenes repetidas entre noticias."
        echo "             Consigue una portada nueva con:"
        echo "               python scripts/portada_noticia.py buscar \"<tema en ingles>\""
        echo "             Guia completa: seo-system/noticias/PORTADAS.md"
        exit 1
    fi
fi

# ---------- 2. lastmod del sitemap ----------
# Se ejecuta cuando cambia cualquier HTML publicado. Corrige las fechas y suma
# el sitemap al commit, para que nunca quede declarando una fecha vieja: Google
# usa lastmod para decidir que vale la pena volver a rastrear.
if git diff --cached --name-only | grep -qE '\.html$'; then
    echo "[pre-commit] Sincronizando fechas del sitemap..."
    if python scripts/sitemap_lastmod.py; then
        if ! git diff --quiet -- sitemap.xml; then
            git add sitemap.xml
            echo "[pre-commit] sitemap.xml actualizado y agregado al commit."
        fi
    else
        echo "[pre-commit] Aviso: no se pudo actualizar el sitemap; continuo igual."
    fi
fi

# ---------- 3. Ultimas publicaciones de la portada ----------
# Se ejecuta cuando cambia el hub de noticias o se agrega una noticia. La portada
# decia "Ultimas Publicaciones" y mostraba un post copiado a mano de junio con la
# antiguedad escrita dura; ademas no enlazaba ninguna noticia propia. Generarlo
# evita que vuelva a envejecer solo.
if git diff --cached --name-only | grep -qE '^noticias/'; then
    echo "[pre-commit] Sincronizando las ultimas publicaciones de la portada..."
    if python scripts/ultimas_publicaciones.py; then
        if ! git diff --quiet -- index.html; then
            git add index.html
            echo "[pre-commit] index.html actualizado y agregado al commit."
        fi
    else
        echo "[pre-commit] Aviso: no se pudo actualizar la portada; continuo igual."
    fi
fi

exit 0
